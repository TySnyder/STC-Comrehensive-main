rules_version = '2';

// TODO(PHI): open for demo-data phase only — no Firebase Auth wired in yet.
// Must be locked down (auth-gated, per-collection) before any real client
// data is stored here. See HANDOFF.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
